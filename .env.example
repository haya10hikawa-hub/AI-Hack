# Public Supabase project configuration. The publishable/anon key is designed
# for browsers; RLS remains the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Required for trusted ingestion/provenance/storage writes. Never
# expose this value through NEXT_PUBLIC_*, browser code, logs, or screenshots.
SUPABASE_SECRET_KEY=your-server-secret-key

# Vercel Cron sends this value as `Authorization: Bearer ...` to the durable
# analysis worker. The checked-in schedule is a Hobby-compatible daily fallback;
# Pro deployments may change it to every minute. Never expose this to clients.
CRON_SECRET=replace-with-a-long-random-secret

# Canonical browser origin used for same-origin mutation checks in production.
APP_ORIGIN=https://your-rememory.example

# Server-only OrcaRouter-compatible OpenAI API endpoint and credential.
AI_API_BASE_URL=https://your-provider.example/v1
AI_API_KEY=replace-me
AI_PROVIDER_NAME=orcarouter
AI_MODEL_VISION_CHEAP=replace-me
AI_MODEL_EVENT_CHEAP=replace-me
AI_MODEL_CHAT_CHEAP=replace-me
AI_MODEL_EVENT_STRONG=replace-me

# Fail-closed cost and abuse protection. Adjust for the deployment.
AI_MAX_COST_USD_PER_USER_DAY=2.50
AI_MAX_COST_USD_PER_REQUEST=0.75
AI_MAX_REQUESTS_PER_USER_MINUTE=12
AI_REQUEST_TIMEOUT_MS=30000
# Upload has three sequential AI stages inside a 60-second background budget.
AI_UPLOAD_TIMEOUT_MS=8000
AI_MAX_RETRIES=1
AI_MAX_RESPONSE_BYTES=512000

# Optional provider-specific prices. Conservative upper-bound defaults apply
# when these are omitted. Repeat the three variables for EVENT_CHEAP,
# CHAT_CHEAP and EVENT_STRONG when the provider publishes exact prices.
# AI_PRICE_VISION_CHEAP_INPUT_USD_PER_MILLION=20
# AI_PRICE_VISION_CHEAP_OUTPUT_USD_PER_MILLION=60
# AI_PRICE_VISION_CHEAP_IMAGE_USD_EACH=0.05

# Upload limits are enforced server-side after magic-byte and decode checks.
UPLOAD_MAX_FILES=12
UPLOAD_MAX_BYTES_PER_FILE=15728640
UPLOAD_MAX_PIXELS=40000000
VISION_MAX_EDGE=1600

# Optional Nominatim-compatible reverse-geocoding endpoint. Only the center of
# the already-coarsened ~10 km grid is sent; exact EXIF GPS is never sent.
# GEOCODER_API_BASE_URL=https://your-geocoder.example/reverse
# GEOCODER_USER_AGENT=ReMemory/1.0 (contact@example.com)
